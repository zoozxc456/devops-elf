# 複製成 .env 後填入實際值（.env 不進 git）

# Loki / Prometheus 接收推送的網卡位址。填監控主機的「內網」IP（或 VPN，如 ZeroTier / Tailscale 的 IP），
# 讓其他主機的 agent 推得進來；不要填 0.0.0.0，這兩個服務沒有驗證。
# 只有本機 agent 時維持 127.0.0.1 即可
BIND_ADDR=127.0.0.1

# Grafana 綁定的位址。預設只綁本機，用 ssh -L 3000:127.0.0.1:3000 連；
# 前面有 reverse proxy（HTTPS）時也維持 127.0.0.1
GRAFANA_BIND_ADDR=127.0.0.1

GRAFANA_ADMIN_USER=admin
# 只在 Grafana 第一次初始化時生效；之後要改請用 Grafana 介面或 grafana cli
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# 使用者在瀏覽器實際開的網址（走 reverse proxy 時填對外網址）
GRAFANA_ROOT_URL=http://localhost:3000
# Grafana 預設時區；browser 表示跟著瀏覽器，也可以填 Asia/Taipei（使用者偏好可覆寫）
GRAFANA_TIMEZONE=browser

# 保留天數
PROMETHEUS_RETENTION=30d
# Loki：env="prod" 的 log 保留 LOKI_RETENTION，其他 env 保留 LOKI_RETENTION_NONPROD
LOKI_RETENTION=720h
LOKI_RETENTION_NONPROD=168h

# 監控資料（Prometheus / Loki / Grafana / Alertmanager）存放位置，建議用獨立的資料碟，
# 塞滿時不會拖垮其他服務。不設就放在 server/data/。目錄權限見 docs/rollout.md
# LOOKOUT_DATA_DIR=/mnt/monitoring
