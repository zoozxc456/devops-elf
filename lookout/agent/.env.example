# 複製成 .env 後填入實際值（.env 不進 git）

# 這台主機的識別名稱，會成為 host / instance label
HOST_NAME=app-host-01

# 這台主機的角色：prod 或其他任意值（例如 staging、dev）。告警規則只看 role="prod"；
# 沒有 lookout.env label 的容器也以這個值當 env
HOST_ROLE=prod

# 應用程式所在的 Docker 網路（docker network ls 確認）。沒有的話先建一個：docker network create app
APP_NETWORK=app

# 上線閘門：只放行列出的環境（regex，例如 "dev"、"dev|test"、"prod"）。
# 沒有 env label 的資料（主機、Alloy 自身）一律放行
LOOKOUT_ENVS=prod

# 不想（或還不能）幫容器加 label 時，用容器名稱 regex 收 log（例如 "nginx|my-api-.*"）。
# 留空表示只收有 lookout.enable=true label 的容器
LOOKOUT_CONTAINERS=

# 監控主機的位址
LOKI_PUSH_URL=http://10.0.0.10:3100/loki/api/v1/push
PROMETHEUS_REMOTE_WRITE_URL=http://10.0.0.10:9090/api/v1/write

# alloy/targets.alloy 用到的連線字串（只有 pg_monitor 之類的唯讀權限，建立方式見 docs/targets.md）。
# 密碼若含特殊字元需 URL encode。名稱自訂，與 targets.alloy 裡的 sys.env("...") 對應即可
# PG_DSN_MAIN=postgresql://monitoring:CHANGE_ME@postgres:5432/postgres?sslmode=disable
# MYSQL_DSN_MAIN=monitoring:CHANGE_ME@(mysql:3306)/
# REDIS_ADDR_CACHE=redis://redis:6379
